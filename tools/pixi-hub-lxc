#!/usr/bin/env bash
# pixi-hub-lxc: setup and maintenance inside the pixi-hub container (run as root).
#
#   pixi-hub-lxc config     menu: Hetzner Storage Box, secrets, GitHub, Obsidian
#   pixi-hub-lxc setup      deploy key + pixi-hub + Obsidian (pull-only) + Hetzner + secrets, in that order
#   pixi-hub-lxc hetzner    only the Hetzner Storage Box (rclone remote hetzner-sbox)
#   pixi-hub-lxc secrets    only the secrets in ~/.config/pixi-hub/env
#   pixi-hub-lxc github     only the GitHub part of setup
#   pixi-hub-lxc claude     install Claude Code and log in with a subscription token (for Claude challengers)
#   pixi-hub-lxc obsidian   only the Obsidian part of setup
#   pixi-hub-lxc status     what is installed, configured and running
#   pixi-hub-lxc go-live    switch to bidirectional sync and start pixi-hub's services
#   pixi-hub-lxc pause      stop pixi-hub's services (sync keeps running) - e.g. to roll back to pixi
#   pixi-hub-lxc update     Debian, obsidian-headless, these scripts and pixi-hub
#   pixi-hub-lxc hub-update only pixi-hub: pull main, install, restart (also as the hub user, e.g. over ssh)
#
# License: MIT
set -Eeuo pipefail
# shellcheck source=../misc/common.func
source /opt/pixi-hub-lxc/misc/common.func
# shellcheck source=/dev/null
[[ -f /etc/pixi-hub-lxc.conf ]] && source /etc/pixi-hub-lxc.conf

HUB_USER="${HUB_USER:-pixi}"
HUB_REPO="${HUB_REPO:-git@github.com:subjektivdk/pixi-hub.git}"
DEVICE_NAME="${DEVICE_NAME:-pixi-hub-lxc}"
REPO_RAW="${REPO_RAW:-https://raw.githubusercontent.com/subjektivdk/proxmox-scripts/main}"

# hub-update and status also work as the hub user, so a new version can be rolled out with plain ssh.
# `update` as the hub user (e.g. after `ssh pixi-hub`) updates what that user may: pixi-hub only.
if [[ $EUID -ne 0 && "$(id -un)" == "$HUB_USER" && "${1:-}" == update ]]; then
  msg_warn "Som $HUB_USER opdateres kun pixi-hub. Resten kræver root: pct enter <id>, så update"
  set -- hub-update
fi
[[ $EUID -eq 0 || ( "$(id -un)" == "$HUB_USER" && "${1:-}" =~ ^(hub-update|status)$ ) ]] \
  || die "Kør som root (fx: pct exec <id> -- pixi-hub-lxc $*)."
HUB_UID=$(id -u "$HUB_USER")
HOME_DIR=$(getent passwd "$HUB_USER" | cut -d: -f6)
VAULT="$HOME_DIR/vault"
HUB_SRC="$HOME_DIR/Projects/pixi-hub"
HUB_UNITS=(pixi-hub.service pixi-hub-pebble.timer pixi-hub-backup.timer)

# Run a command as the hub user with a proper home and access to its systemd user instance.
as_user() {
  if [[ $EUID -ne 0 ]]; then
    env XDG_RUNTIME_DIR="/run/user/$HUB_UID" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$HUB_UID/bus" \
      PATH="$HOME_DIR/.local/bin:$PATH" "$@"
    return
  fi
  runuser -u "$HUB_USER" -- env HOME="$HOME_DIR" USER="$HUB_USER" \
    PATH="$HOME_DIR/.local/bin:/usr/local/bin:/usr/bin:/bin" \
    XDG_RUNTIME_DIR="/run/user/$HUB_UID" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$HUB_UID/bus" \
    "$@"
}
ob_() { as_user ob "$@"; }
usersys() { as_user systemctl --user "$@"; }
wt() { whiptail --backtitle "pixi-hub LXC" "$@" 3>&1 1>&2 2>&3; }

# --- github -----------------------------------------------------------------
# GitHub always ends `ssh -T` with exit 1 (no shell access), so look at the text, not the exit code (pipefail).
github_ok() {
  local out
  out=$(as_user ssh -o BatchMode=yes -T git@github.com 2>&1 || true)
  [[ "$out" == *"successfully authenticated"* ]]
}

repo_slug() { sed -E 's#^(git@github.com:|https://github.com/)##; s#\.git$##' <<<"$HUB_REPO"; }

cmd_github() {
  if ! github_ok; then
    echo
    echo -e "${BOLD}Deploy key til $(repo_slug)${CL}"
    echo -e "Tilføj nøglen som ${BOLD}read-only${CL} deploy key (Allow write access: fra):"
    echo -e "  ${BGN}https://github.com/$(repo_slug)/settings/keys/new${CL}"
    echo -e "  Title: ${BOLD}$DEVICE_NAME${CL}"
    echo
    cat "$HOME_DIR/.ssh/pixi-hub-deploy.pub"
    echo
    while ! github_ok; do
      read -r -p "Tryk Enter, når nøglen er tilføjet (eller skriv s for at springe over): " ans </dev/tty
      [[ "$ans" == "s" ]] && { msg_warn "Sprang GitHub over. Kør senere: pixi-hub-lxc github"; return 0; }
      github_ok || msg_warn "GitHub kender ikke nøglen endnu."
    done
  fi
  msg_ok "GitHub accepterer deploy key"

  if [[ -d "$HUB_SRC/.git" ]]; then
    msg_info "Henter seneste pixi-hub"
    silent as_user git -C "$HUB_SRC" pull --ff-only
  else
    msg_info "Kloner pixi-hub"
    silent as_user git clone "$HUB_REPO" "$HUB_SRC"
  fi
  msg_ok "pixi-hub-kode i $HUB_SRC ($(as_user git -C "$HUB_SRC" log -1 --format=%h))"
  install_hub
}

install_hub() {
  msg_info "Installerer pixi-hub med uv (inkl. jev)"
  silent as_user uv tool install --force "${HUB_SRC}[jev]"
  msg_ok "Installerede pixi-hub ($(as_user pixi-hub --version 2>/dev/null || echo '?'))"

  msg_info "Kopierer systemd-units fra repoet"
  local u
  for u in "${HUB_UNITS[@]}" pixi-hub-pebble.service pixi-hub-backup.service; do
    [[ -f "$HUB_SRC/deploy/systemd/$u" ]] && install -m 0644 -o "$HUB_USER" -g "$HUB_USER" \
      "$HUB_SRC/deploy/systemd/$u" "$HOME_DIR/.config/systemd/user/$u"
  done
  # pixi-hub waits for the vault sync instead of a desktop Obsidian.
  install -d -o "$HUB_USER" -g "$HUB_USER" "$HOME_DIR/.config/systemd/user/pixi-hub.service.d"
  cat >"$HOME_DIR/.config/systemd/user/pixi-hub.service.d/obsidian-sync.conf" <<'EOF'
[Unit]
After=obsidian-sync.service
Wants=obsidian-sync.service
EOF
  chown "$HUB_USER:$HUB_USER" "$HOME_DIR/.config/systemd/user/pixi-hub.service.d/obsidian-sync.conf"
  usersys daemon-reload
  msg_ok "Kopierede units (ikke slået til; det sker ved go-live)"
}

# --- obsidian ---------------------------------------------------------------
ob_logged_in() { ob_ sync-list-remote --json >/dev/null 2>&1; }
ob_configured() { ob_ sync-status --path "$VAULT" >/dev/null 2>&1; }

cmd_obsidian() {
  if ! ob_logged_in; then
    echo
    echo -e "${BOLD}Log ind på Obsidian${CL} (e-mail, password og evt. 2FA)"
    as_user ob login </dev/tty || die "Login fejlede. Prøv igen: pixi-hub-lxc obsidian"
  fi
  msg_ok "Logget ind på Obsidian"

  if ! ob_configured; then
    local json items=() vault
    json=$(ob_ sync-list-remote --json)
    while IFS=$'\t' read -r id name; do items+=("$id" "$name"); done \
      < <(jq -r '(.vaults + .shared)[] | [.id, .name] | @tsv' <<<"$json")
    [[ ${#items[@]} -gt 0 ]] || die "Kontoen har ingen remote vaults."
    vault=$(wt --title "Obsidian Sync" --menu "Hvilket vault skal synkes til $VAULT?" 16 70 8 "${items[@]}") || exit 1
    echo -e "Er vaultet end-to-end-krypteret, spørger ob om krypteringspasswordet nu."
    as_user ob sync-setup --vault "$vault" --path "$VAULT" --device-name "$DEVICE_NAME" </dev/tty \
      || die "sync-setup fejlede. Prøv igen: pixi-hub-lxc obsidian"
  fi
  msg_ok "Vaultet er koblet til Obsidian Sync"

  # Start safely: pull-only until go-live. Only notes (no attachments, no .obsidian configs).
  # 'unsupported' must stay out of file-types, or pixi-hub's temporary files could be synced.
  msg_info "Sætter sync til pull-only"
  silent ob_ sync-config --path "$VAULT" --mode pull-only --configs "" --file-types "" \
    --conflict-strategy merge --device-name "$DEVICE_NAME"
  msg_ok "Sync: pull-only, kun noter"

  msg_info "Starter obsidian-sync.service"
  usersys daemon-reload
  silent usersys enable obsidian-sync.service
  silent usersys restart obsidian-sync.service
  msg_ok "obsidian-sync kører ($(find "$VAULT" -name '*.md' 2>/dev/null | wc -l) noter indtil videre)"
}

# --- hetzner storage box ------------------------------------------------------
# pixi-hub uses the rclone remote "hetzner-sbox": pebble fetches watch data from
# hetzner-sbox:home/pixi-sync/inbox and deploy/backup.sh writes its nightly backup there.
SBOX_REMOTE="hetzner-sbox"

sbox_ok() { as_user rclone lsd "$SBOX_REMOTE:" --contimeout 10s --timeout 20s >/dev/null 2>&1; }

cmd_hetzner() {
  if as_user rclone listremotes | grep -qx "$SBOX_REMOTE:"; then
    if sbox_ok; then
      wt --title "Hetzner Storage Box" --yesno "Remoten $SBOX_REMOTE findes og virker.\n\nVil du sætte den op igen?" 10 60 \
        || { msg_ok "Hetzner Storage Box virker"; return 0; }
    else
      msg_warn "Remoten $SBOX_REMOTE findes, men forbindelsen fejler. Sæt den op igen."
    fi
  fi

  local user host port pass obscured
  user=$(wt --title "Hetzner Storage Box" --inputbox \
    "Brugernavn på hovedkontoen (Hetzner Console > Storage Box, fx u123456, uden -sub)" 10 70 "") || return 1
  [[ "$user" =~ ^u[0-9]+(-sub[0-9]+)?$ ]] || { msg_error "Brugernavnet ligner ikke en Storage Box-bruger (u123456 eller u123456-sub1)."; return 1; }
  host=$(wt --title "Hetzner Storage Box" --inputbox "Server" 8 70 "${user%%-sub*}.your-storagebox.de") || return 1
  port=$(wt --title "Hetzner Storage Box" --inputbox "SSH-port (Storage Box bruger 23)" 8 70 "23") || return 1
  pass=$(wt --title "Hetzner Storage Box" --passwordbox "Password til $user\n\nHovedkontoens password, ikke pixi-sync-underkontoens (-sub). Hetzner blokerer hjemmenettets IP efter flere forkerte forsøg, og så står også pixi-sync og backup stille." 12 70) || return 1
  [[ -n "$pass" ]] || { msg_error "Tomt password."; return 1; }

  msg_info "Gemmer rclone-remoten $SBOX_REMOTE"
  # Obscure via stdin so the password never appears in a process list or shell history.
  obscured=$(printf '%s' "$pass" | as_user rclone obscure -)
  unset pass
  as_user rclone config delete "$SBOX_REMOTE" >/dev/null 2>&1 || true
  silent as_user rclone config create "$SBOX_REMOTE" sftp \
    host="$host" user="$user" port="$port" pass="$obscured" \
    shell_type=unix md5sum_command=md5sum sha1sum_command=sha1sum --no-obscure
  chmod 600 "$HOME_DIR/.config/rclone/rclone.conf"
  msg_ok "Gemte $SBOX_REMOTE i ~$HUB_USER/.config/rclone/rclone.conf"

  msg_info "Tester forbindelsen"
  if ! sbox_ok; then
    msg_error "Kunne ikke logge ind på $host:$port som $user."
    echo -e "${TAB}${TAB}Tjek password, og at SSH er slået til for Storage Box'en i Hetzner Console."
    return 1
  fi
  msg_ok "Forbindelsen til Hetzner Storage Box virker"
  if as_user rclone lsd "$SBOX_REMOTE:home/pixi-sync" >/dev/null 2>&1; then
    msg_ok "Fandt pixi-sync's mappe (home/pixi-sync)"
  else
    msg_warn "Fandt ikke home/pixi-sync. Den oprettes af pixi-sync-appen, når uret sender første gang."
  fi
}

# --- secrets ------------------------------------------------------------------
ENV_FILE="$HOME_DIR/.config/pixi-hub/env"

env_has() { grep -q "^$1=." "$ENV_FILE" 2>/dev/null; }

# Sets KEY=value in the env file without leaving the value anywhere else.
env_set() {
  local key=$1 value=$2 tmp
  tmp=$(mktemp)
  grep -v "^$key=" "$ENV_FILE" 2>/dev/null >"$tmp" || true
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
  install -m 0600 -o "$HUB_USER" -g "$HUB_USER" "$tmp" "$ENV_FILE"
  rm -f "$tmp"
}

# KEY|what it is for|text or password. Only TYPESAFE_API_KEY is needed for the notes; the rest are for electricity.
SECRETS=(
  "TYPESAFE_API_KEY|readiness: Jev-probability (uden den fejler readiness)|password"
  "ELOVERBLIK_REFRESH_TOKEN|electricity: gårsdagens forbrug (eloverblik.dk > Datadeling > Opret token)|password"
  "EASEE_USERNAME|electricity: ladeplanen (samme login som Easee-appen)|text"
  "EASEE_PASSWORD|electricity: ladeplanen (password til Easee)|password"
)

cmd_secrets() {
  local entry key desc kind text value
  for entry in "${SECRETS[@]}"; do
    IFS="|" read -r key desc kind <<<"$entry"
    text="$key\n\n$desc"
    env_has "$key" && text+="\n\nDer er allerede en værdi. Tom = behold den."
    if [[ "$kind" == "text" ]]; then
      value=$(wt --title "Hemmeligheder" --inputbox "$text" 14 74 "") || return 1
    else
      value=$(wt --title "Hemmeligheder" --passwordbox "$text" 14 74) || return 1
    fi
    if [[ -n "$value" ]]; then
      env_set "$key" "$value"
      msg_ok "Gemte $key i $ENV_FILE (chmod 600)"
    elif env_has "$key"; then
      msg_ok "Beholdt $key"
    else
      msg_warn "Ingen $key (${desc%%:*} mangler den)"
    fi
  done
  unset value
}

# --- claude code ----------------------------------------------------------------
# Readiness challengers can ask Claude via headless `claude -p` with Martin's subscription. `claude setup-token`
# makes a long-lived token, which goes into the env file as CLAUDE_CODE_OAUTH_TOKEN (read by the systemd service).
CLAUDE="$HOME_DIR/.local/bin/claude"

claude_installed() { [[ -x "$CLAUDE" ]]; }
claude_ok() {
  env_has CLAUDE_CODE_OAUTH_TOKEN || return 1
  local token out
  token=$(sed -n 's/^CLAUDE_CODE_OAUTH_TOKEN=//p' "$ENV_FILE")
  out=$(cd /tmp && as_user env CLAUDE_CODE_OAUTH_TOKEN="$token" "$CLAUDE" -p "Svar kun: ok" --model haiku \
    --tools "" --setting-sources "" --no-session-persistence --output-format json 2>/dev/null) || return 1
  [[ "$(jq -r .is_error <<<"$out" 2>/dev/null)" == "false" ]]
}

cmd_claude() {
  if ! claude_installed; then
    msg_info "Installerer Claude Code"
    as_user sh -c 'curl -fsSL https://claude.ai/install.sh | bash' >/dev/null 2>&1 \
      || { msg_error "Installationen af Claude Code fejlede."; return 1; }
  fi
  msg_ok "Claude Code $(as_user "$CLAUDE" --version 2>/dev/null | head -1)"

  if env_has CLAUDE_CODE_OAUTH_TOKEN; then
    wt --title "Claude Code" --yesno "Der er allerede en token i env.\n\nVil du lave en ny?" 10 60 \
      || { msg_ok "Beholdt CLAUDE_CODE_OAUTH_TOKEN"; return 0; }
  fi
  echo
  echo -e "${BOLD}Log ind på Claude${CL} med dit abonnement: åbn linket i en browser, log ind, og indsæt koden her."
  echo
  # setup-token prints the token and exits at once, so its screen is recorded (script keeps the terminal) and the
  # token is picked up from the recording. Only if that fails is Martin asked to paste it, in the terminal.
  local rec token=""
  rec=$(mktemp)
  chmod 600 "$rec"; chown "$HUB_USER" "$rec"
  as_user script -q -c "$CLAUDE setup-token" "$rec" </dev/tty || true
  token=$(sed 's/\x1b\[[0-9;?]*[A-Za-z]//g' "$rec" | grep -ao 'sk-ant-oat01-[A-Za-z0-9_-]\{20,\}' | tail -n1 || true)
  rm -f "$rec"
  echo
  if [[ -n "$token" ]]; then
    msg_ok "Fandt tokenen"
  else
    msg_warn "Kunne ikke finde tokenen automatisk."
    read -r -s -p "Indsæt tokenen (sk-ant-oat01-…) og tryk Enter: " token </dev/tty
    echo
  fi
  [[ "$token" == sk-ant-* ]] || { msg_error "Det ligner ikke en Claude-token."; return 1; }
  env_set CLAUDE_CODE_OAUTH_TOKEN "$token"
  msg_info "Tester claude -p med Haiku"
  if ! claude_ok; then
    # A token broken over two lines on screen is picked up only in part; it is still visible above.
    msg_warn "Claude svarede ikke med den fundne token."
    read -r -s -p "Kopiér tokenen fra skærmen ovenfor, indsæt den og tryk Enter: " token </dev/tty
    echo
    env_set CLAUDE_CODE_OAUTH_TOKEN "$token"
    claude_ok || { msg_error "Claude svarede ikke. Prøv igen: pixi-hub-lxc claude"; return 1; }
  fi
  unset token
  msg_ok "Claude svarer. Tokenen ligger i $ENV_FILE (chmod 600)"
}

# --- config menu --------------------------------------------------------------
secrets_ok() {
  local entry
  for entry in "${SECRETS[@]}"; do env_has "${entry%%|*}" || return 1; done
}

mark() { if eval "$1" >/dev/null 2>&1; then echo "✔"; else echo "✖"; fi; }

cmd_config() {
  local choice
  while true; do
    choice=$(wt --title "pixi-hub LXC: konfiguration" --cancel-button "Færdig" --menu \
      "Vælg, hvad du vil sætte op (✔ = virker)" 16 72 6 \
      "hetzner"  "$(mark sbox_ok) Hetzner Storage Box (urdata og backup)" \
      "secrets"  "$(mark secrets_ok) Hemmeligheder (Jev, Eloverblik, Easee)" \
      "github"   "$(mark github_ok) GitHub deploy key og pixi-hub" \
      "obsidian" "$(mark ob_configured) Obsidian Sync" \
      "claude"   "$(mark 'env_has CLAUDE_CODE_OAUTH_TOKEN') Claude Code (challengers med Claude)" \
      "status"   "  Vis samlet status") || break
    case "$choice" in
      hetzner) cmd_hetzner || true ;;
      secrets) cmd_secrets || true ;;
      github) cmd_github || true ;;
      obsidian) cmd_obsidian || true ;;
      claude) cmd_claude || true ;;
      status) cmd_status ;;
    esac
    read -r -p "Tryk Enter for at gå tilbage til menuen " _ </dev/tty
  done
}

# --- status -----------------------------------------------------------------
check() { if eval "$2" >/dev/null 2>&1; then echo -e "$CM$1"; else echo -e "$CROSS$1"; fi; }

cmd_status() {
  echo -e "${BOLD}pixi-hub LXC${CL}  ($(hostname), $(hostname -I | awk '{print $1}'))"
  echo
  echo -e "${BOLD}Installation${CL}"
  check "Node $(node --version 2>/dev/null)" "command -v node"
  check "obsidian-headless" "command -v ob"
  check "uv" "as_user uv --version"
  check "pixi-hub installeret" "as_user pixi-hub --version"
  check "GitHub deploy key virker" "github_ok"
  echo
  echo -e "${BOLD}Obsidian${CL}"
  check "Logget ind" "ob_logged_in"
  check "Vault koblet til ($VAULT)" "ob_configured"
  check "obsidian-sync.service kører" "usersys is-active obsidian-sync.service"
  if ob_configured; then
    ob_ sync-config --path "$VAULT" 2>/dev/null | sed "s/^/$TAB$TAB/" || true
  fi
  echo
  echo -e "${BOLD}Migrering fra pixi${CL}"
  check "Config (~/.config/pixi-hub/pixi-hub.toml)" "test -f '$HOME_DIR/.config/pixi-hub/pixi-hub.toml'"
  check "Config peger på $VAULT" "vault_ok"
  check "Database" "test -f '$HOME_DIR/.local/share/pixi-hub/pixi-hub.db'"
  check "age-nøgle til urdata" "test -f '$HOME_DIR/.local/share/pixi-hub/pebble-age.key'"
  check "Hetzner Storage Box (rclone-remote hetzner-sbox)" "sbox_ok"
  check "Rå eksporter (imports/ til history)" "test -d '$HOME_DIR/.local/share/pixi-hub/imports'"
  check "Backup-stempel (last-backup, Zabbix måler alderen)" "test -f '$HOME_DIR/.local/share/pixi-hub/last-backup'"
  local entry
  for entry in "${SECRETS[@]}"; do
    check "${entry%%|*} i env" "env_has ${entry%%|*}"
  done
  echo
  echo -e "${BOLD}Kilder${CL}"
  check "Zabbix nås (${ZBX:-$(zbx_server)}:10051)" "zbx_ok"
  check "tasks_command kan køres" "tasks_ok"
  check "Claude Code installeret" "claude_installed"
  check "Claude-token i env (CLAUDE_CODE_OAUTH_TOKEN)" "env_has CLAUDE_CODE_OAUTH_TOKEN"
  echo
  echo -e "${BOLD}Tjenester${CL}"
  local u
  for u in "${HUB_UNITS[@]}"; do
    check "$u ($(usersys is-active "$u" 2>/dev/null || true))" "usersys is-active $u"
  done
}

CONF="$HOME_DIR/.config/pixi-hub/pixi-hub.toml"

# A string setting from one [section] of the hub's config (enough for these checks; pixi-hub parses it properly).
conf_get() {
  awk -v sec="[$1]" -v key="$2" '/^\[/{s=($0==sec)} s && $1==key {sub(/^[^=]*= *"/,""); sub(/".*/,""); print; exit}' "$CONF" 2>/dev/null
}
zbx_server() { conf_get modules.zabbix server; }
zbx_ok() { local s; s=$(zbx_server); [[ -n "$s" ]] && timeout 5 bash -c "</dev/tcp/$s/10051"; }
tasks_ok() {
  local cmd; cmd=$(conf_get modules.brief tasks_command)
  [[ -n "$cmd" ]] && as_user sh -c "command -v '${cmd%% *}'"
}

vault_ok() {
  [[ "$(as_user pixi-hub --json describe 2>/dev/null | jq -r .vault)" == "$VAULT" ]]
}

# --- go-live / pause ----------------------------------------------------------
cmd_go_live() {
  local missing=()
  as_user pixi-hub --version >/dev/null 2>&1 || missing+=("pixi-hub er ikke installeret (pixi-hub-lxc github)")
  ob_configured || missing+=("vaultet er ikke sat op (pixi-hub-lxc obsidian)")
  [[ -f "$HOME_DIR/.config/pixi-hub/pixi-hub.toml" ]] || missing+=("config mangler")
  vault_ok || missing+=("config peger ikke på $VAULT ([hub] vault)")
  [[ -f "$HOME_DIR/.local/share/pixi-hub/pixi-hub.db" ]] || missing+=("database mangler")
  if ((${#missing[@]})); then
    msg_error "Ikke klar til go-live:"
    printf "${TAB}${TAB}- %s\n" "${missing[@]}"
    exit 1
  fi
  echo -e "${RD}${BOLD}Vigtigt:${CL} pixi-hub må ikke køre andre steder (fx på pixi), når den startes her."
  read -r -p "Er hubben stoppet alle andre steder? Skriv ja: " ans </dev/tty
  [[ "$ans" == "ja" ]] || die "Afbrudt."

  msg_info "Skifter sync til bidirectional"
  silent ob_ sync-config --path "$VAULT" --mode bidirectional
  silent usersys restart obsidian-sync.service
  msg_ok "Sync: bidirectional"

  msg_info "Starter pixi-hub"
  silent usersys enable --now "${HUB_UNITS[@]}"
  msg_ok "pixi-hub kører. Følg med: journalctl --user -u pixi-hub -f (som $HUB_USER)"
}

cmd_pause() {
  msg_info "Stopper pixi-hub"
  silent usersys disable --now "${HUB_UNITS[@]}"
  msg_ok "pixi-hub stoppet (obsidian-sync kører videre)"
}

# --- hub-update -----------------------------------------------------------------
# The way new code reaches the container: develop and test on pixi, push to main, then
#   ssh pixi-hub pixi-hub-lxc hub-update
cmd_hub_update() {
  [[ -d "$HUB_SRC/.git" ]] || die "pixi-hub er ikke klonet endnu (pixi-hub-lxc github)."
  local before after
  before=$(as_user git -C "$HUB_SRC" rev-parse --short HEAD)
  msg_info "Henter pixi-hub"
  silent as_user git -C "$HUB_SRC" pull --ff-only
  after=$(as_user git -C "$HUB_SRC" rev-parse --short HEAD)
  if [[ "$before" == "$after" ]]; then
    msg_ok "pixi-hub er allerede opdateret ($after)"
    [[ "${2:-}" == "--force" ]] || return 0
  else
    msg_ok "pixi-hub $before → $after"
    as_user git -C "$HUB_SRC" log --format="${TAB}${TAB}%h %s" "$before..$after"
  fi
  install_hub
  if usersys is-active pixi-hub.service >/dev/null 2>&1; then
    usersys restart pixi-hub.service
    sleep 3
    usersys is-active pixi-hub.service >/dev/null 2>&1 \
      || die "pixi-hub startede ikke igen. Se: journalctl --user -u pixi-hub -n 50"
    msg_ok "Genstartede pixi-hub"
  else
    msg_warn "pixi-hub kører ikke her (før go-live), så den er ikke genstartet"
  fi
}

# --- update -------------------------------------------------------------------
cmd_update() {
  msg_info "Opdaterer Debian"
  silent apt-get update
  export DEBIAN_FRONTEND=noninteractive
  silent apt-get -y -o Dpkg::Options::=--force-confold dist-upgrade
  msg_ok "Opdaterede Debian"

  msg_info "Opdaterer obsidian-headless"
  silent npm install -g --allow-scripts=better-sqlite3 obsidian-headless@latest
  msg_ok "Opdaterede obsidian-headless"

  msg_info "Opdaterer pixi-hub-lxc-scripts"
  local f tmp
  for f in misc/common.func install/pixi-hub-install.sh tools/pixi-hub-lxc; do
    tmp=$(mktemp)
    curl -fsSL "$REPO_RAW/$f" -o "$tmp" && install -m 0755 "$tmp" "/opt/pixi-hub-lxc/$f"
    rm -f "$tmp"
  done
  ln -sf /opt/pixi-hub-lxc/tools/pixi-hub-lxc /usr/bin/pixi-hub-lxc  # pct exec has no /usr/local/bin in PATH
  msg_ok "Opdaterede scripts"

  if claude_installed; then
    msg_info "Opdaterer Claude Code"
    silent as_user "$CLAUDE" update || true
    msg_ok "Claude Code $(as_user "$CLAUDE" --version 2>/dev/null | head -1)"
  fi

  if [[ -d "$HUB_SRC/.git" ]] && github_ok; then
    cmd_hub_update update --force
  else
    msg_warn "Sprang pixi-hub over (ikke klonet eller ingen GitHub-adgang)"
  fi

  # pixi-hub itself was restarted by hub-update.
  if usersys is-active obsidian-sync.service >/dev/null 2>&1; then
    usersys restart obsidian-sync.service
    msg_ok "Genstartede obsidian-sync.service"
  fi
}

case "${1:-}" in
  setup) cmd_github; cmd_obsidian; cmd_hetzner || true; cmd_secrets || true; cmd_claude || true; echo; cmd_status ;;
  config) cmd_config ;;
  hetzner) cmd_hetzner ;;
  secrets) cmd_secrets ;;
  github) cmd_github ;;
  obsidian) cmd_obsidian ;;
  claude) cmd_claude ;;
  status) cmd_status ;;
  go-live) cmd_go_live ;;
  pause) cmd_pause ;;
  update) cmd_update ;;
  hub-update) cmd_hub_update "$@" ;;
  *) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
